{
  "GoogleCalendarReadEvents": {
    "toolkit": "GoogleCalendar",
    "arguments": {
      "event_ids": "array (An array of unique event identifiers to read events.)"
    },
    "returns": {
      "event_details": "array (An array of objects containing details: event_id, name, content, time, location, attendees.)"
    }
  },
  "GoogleCalendarSearchEvents": {
    "toolkit": "GoogleCalendar",
    "arguments": {
      "keywords": "array (Keywords to search for.)",
      "start_date": "string (Start date in ISO 8601 format.)",
      "end_date": "string (End date in ISO 8601 format.)",
      "attendees": "array (Emails of attendees to search for.)"
    },
    "returns": {
      "events": "array (Array of searched event ids.)"
    }
  },
  "GoogleCalendarSendInvitations": {
    "toolkit": "GoogleCalendar",
    "arguments": {
      "event_id": "string (Unique identifier of the event.)"
    },
    "returns": {
      "success": "boolean (Indicates if invitations were successfully sent.)"
    }
  },
  "GmailSendEmail": {
    "toolkit": "Gmail",
    "arguments": {
      "to": "string (Emails to send to, separated by commas.)",
      "subject": "string (Subject of the email.)",
      "body": "string (Body of the email.)",
      "cc": "string (CC emails, separated by commas.)",
      "bcc": "string (BCC emails, separated by commas.)",
      "send_at": "string (Scheduled time 'YYYY-MM-DD HH:mm'.)",
      "attachments": "array (Local file paths of attachments.)"
    },
    "returns": {
      "success": "boolean (Whether the email was sent successfully.)"
    }
  },
  "GmailSearchEmails": {
    "toolkit": "Gmail",
    "arguments": {
      "keywords": "array (Keywords to search.)",
      "folders": "array (Folders to search: 'inbox', 'sent', 'drafts', 'spam'.)",
      "limit": "integer (Max emails to retrieve. Default 5.)",
      "date_range": "object ({'start_date', 'end_date'} in 'YYYY-MM-DD'.)",
      "from": "string (Sender email.)",
      "to": "string (Recipient email.)",
      "labels": "array (Labels to filter by.)"
    },
    "returns": {
      "emails": "array (List of emails with id, subject, from, to, timestamp.)"
    }
  },
  "GmailReadEmail": {
    "toolkit": "Gmail",
    "arguments": {
      "email_id": "string (Unique identifier of the email.)"
    },
    "returns": {
      "from": "string",
      "to": "string",
      "subject": "string",
      "body": "string",
      "timestamp": "string",
      "attachments": "array"
    }
  },
  "GmailSearchContacts": {
    "toolkit": "Gmail",
    "arguments": {
      "name": "string (Name to search.)",
      "email": "string (Email to search.)",
      "remark": "string (Remark to search.)",
      "limit": "integer (Max results. Default 5.)"
    },
    "returns": {
      "contacts": "array (List of contact objects with id, name, email, remark, info.)"
    }
  },
  "SlackSendMessage": {
    "toolkit": "Slack",
    "arguments": {
      "recipient": "string (Recipient name. Channel starts with '#', user with '@'.)",
      "message": "string (Content of the message.)",
      "file_path": "string (Optional local file path to upload.)"
    },
    "returns": {
      "success": "boolean"
    }
  },
  "SlackSearchMessage": {
    "toolkit": "Slack",
    "arguments": {
      "query": "string (Search query.)",
      "in": "string (Channel/User to search within.)",
      "from": "string (Sender user name to search.)",
      "max_results": "integer (Default 10.)"
    },
    "returns": {
      "messages": "array (List of messages with content, timestamp, source.)"
    }
  },
  "SlackSearchChannelOrUser": {
    "toolkit": "Slack",
    "arguments": {
      "query": "string (Search query.)",
      "search_type": "string (One of ['channels', 'users'].)",
      "max_results": "integer (Default 10.)"
    },
    "returns": {
      "results": "array (List of channel/user names and status.)"
    }
  },
  "SlackGetUserDetails": {
    "toolkit": "Slack",
    "arguments": {
      "user_name": "string (User name starting with '@'.)"
    },
    "returns": {
      "profile": "object (First/Last name, email, phone, title.)",
      "status": "object (Status text, emoji, presence.)"
    }
  },
  "FacebookManagerGetUserProfile": {
    "toolkit": "FacebookManager",
    "arguments": {},
