    }
  },
  "FacebookManagerSearchPosts": {
    "toolkit": "FacebookManager",
    "arguments": {
      "user_id": "string (User ID to search posts for.)",
      "keyword": "string (Keyword to search.)",
      "max_results": "integer"
    },
    "returns": {
      "posts": "array (List of posts with id and content.)"
    }
  },
